{
  "name": "onboard-corrugated-hs-desktop",
  "version": "4.9.3",
  "description": "Local Onboard Corrugated Health and Safety Dashboard",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:syntax": "node --check main.js && node --check preload.js && node --check updates.js && node --check app/auto-backup.js && node --check app/dashboard-check.js",
    "test:updates": "node --test updates.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uk.onboardcorrugated.hs.dashboard",
    "productName": "Onboard H&S Dashboard",
    "asar": true,
    "files": [
      "app/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "update-config.json",
      "updates.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Onboard-HS-Dashboard-Setup-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.7.0"
  }
}
