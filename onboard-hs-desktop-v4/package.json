{
  "name": "onboard-corrugated-hs-desktop",
  "version": "4.6.0",
  "description": "Local Onboard Corrugated Health and Safety Dashboard",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test:syntax": "node --check main.js && node --check preload.js && node --check app/dashboard-check.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uk.onboardcorrugated.hs.dashboard",
    "productName": "Onboard H&S Dashboard",
    "asar": true,
    "files": [
      "app/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
