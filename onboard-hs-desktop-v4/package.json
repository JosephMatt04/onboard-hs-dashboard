{
  "name": "onboard-corrugated-hs-desktop",
  "version": "4.13.3",
  "description": "Local Onboard Corrugated Health and Safety Dashboard",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:syntax": "node --check main.js && node --check preload.js && node --check updates.js && node --check app/auto-backup.js && node --check app/dashboard-check.js && node --check section-pin.js && node --check dashboard-smoke.test.js && node --check desktop-storage.test.js && node --check github-direct-updates.js && node --check live-ui-updates.js && node --check live-ui-updates.test.js && node --check github-direct-updates.test.js",
    "test:updates": "node --test updates.test.js",
    "test:pin": "node --test section-pin.test.js",
    "test:dashboard": "node --test dashboard-smoke.test.js",
    "test:storage": "node --test desktop-storage.test.js",
    "test:github-updates": "node --test github-direct-updates.test.js",
    "test:live-ui": "node --test live-ui-updates.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uk.onboardcorrugated.hs.dashboard",
    "productName": "Onboard H&S Dashboard",
    "asar": true,
    "files": [
      "app/**/*",
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "update-config.json",
      "updates.js",
      "section-pin.js",
      "github-direct-updates.js",
      "live-ui-updates.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "artifactName": "Onboard-HS-Dashboard-Setup-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.7.0"
  }
}
